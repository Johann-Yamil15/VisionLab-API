{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    // --- CONFIGURACIÓN DE MONGODB GENÉRICA ---
    "VisionLabDatabase": {
        "ConnectionString": "mongodb://localhost:27017",
        "DatabaseName": "vision_lab",
        "Collections": {
            "Hallazgos": "hallazgos", // Colección para los hallazgos (Almanaque)
            "Usuarios": "usuarios", // Colección para el registro y perfiles
            "Niveles": "niveles", // Colección opcional para la lógica de gamificación
            "Logros": "logros" // Colección opcional para los logros
        }
    }
}
