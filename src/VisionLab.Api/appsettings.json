{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VisionLabDatabase": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "vision_lab",
    "Collections": {
      "Hallazgos": "hallazgos",
      "Usuarios": "usuarios",
      "Niveles": "niveles",
      "Logros": "logros"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ClaudeCli": {
    "Command": "claude",
    "TimeoutSeconds": 60,
    "Model": "sonnet"
  },
  "Jwt": {
    "Issuer": "VisionLab",
    "Audience": "VisionLabApp",
    "DiasValidez": 7
  }
}
